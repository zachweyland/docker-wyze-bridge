+// pliMinInterval is the global floor between upstream keyframe requests for a
+// stream. Without it, sustained packet loss triggers a PLI storm: every lost
+// packet demands a full IDR, whose ~300-packet burst saturates the camera
+// uplink and causes the next loss.
+func pliMinInterval() time.Duration {
+	const defaultInterval = 3 * time.Second
+
+	raw := strings.TrimSpace(os.Getenv("WHEP_PLI_MIN_INTERVAL_MS"))
+	if raw == "" {
+		return defaultInterval
+	}
+
+	ms, err := strconv.Atoi(raw)
+	if err != nil || ms < 0 {
+		log.Printf(
+			"[WHEP_PROXY] Invalid WHEP_PLI_MIN_INTERVAL_MS=%q, using default %v",
+			raw,
+			defaultInterval,
+		)
+		return defaultInterval
+	}
+
+	return time.Duration(ms) * time.Millisecond
+}
